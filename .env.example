# Proyecto Ágil — configuración de desarrollo
# La aplicación aún está en implementación. Estas variables fijan su configuración prevista.
# Completa OpenAI, Chatwoot, plantilla y dominio en .env; no publiques ese archivo privado.
# MEDIA_ALLOWED_HOSTS: nombres de host permitidos, separados por comas, sin https://.
# CHATWOOT_BASE_URL: origen de Chatwoot, sin /app ni /api/v1 al final.
# Cuenta e inbox: IDs numéricos. No se requiere token directo de Meta: usamos Chatwoot.
# La plantilla, idioma y categoría deben coincidir con los aprobados en tu inbox.
# CHATWOOT_WEBHOOK_SECRET: el secreto configurado en la fuente; no confundir con el API token.
# Si la fuente no firma, se configurará un relay; no habilitar entrada pública sin autenticación.
# El teléfono del evaluador se editará desde la central, no desde este archivo.
# No ejecutes `source .env`; el archivo lo cargará la aplicación / Docker Compose.

# COMPLETA: servicios externos. Las claves reales van solo en este archivo privado.
OPENAI_API_KEY=
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_TEMPLATE_NAME=
CHATWOOT_TEMPLATE_LANGUAGE=
CHATWOOT_TEMPLATE_CATEGORY=UTILITY
MEDIA_ALLOWED_HOSTS=

# URL pública de la aplicación. Sustituye localhost por tu dominio HTTPS al conectar Chatwoot.
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_DOMAIN=
# Dominio previsto: cobranza.agenx-dev-test.work; activar PUBLIC_BASE_URL HTTPS al conectar.
# Token de ejecución del túnel, privado; no es una API key de administración Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=
TIMEZONE=America/Bogota
DEMO_MODE=true
ENABLE_LOCAL_MESSAGE_ENDPOINT=true

# Adaptador Chatwoot: confirmar esquema y firma con la instalación existente.
CHATWOOT_AUTH_SCHEME=api_access_token
CHATWOOT_WEBHOOK_AUTH_MODE=hmac
CHATWOOT_RELAY_TOKEN=
CHATWOOT_WEBHOOK_TOLERANCE_SECONDS=300

# OpenAI: valores del plan; modelos configurables, acceso pendiente de preflight.
OPENAI_AGENT_MODEL=gpt-5.6-luna
OPENAI_AGENT_REASONING_EFFORT=high
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_VISION_REASONING_EFFORT=none
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
AI_TOTAL_BUDGET_USD=5.00
AI_LOCAL_SPEND_LIMIT_USD=4.50
AI_MAX_CONCURRENT_REQUESTS=2
AI_MAX_CALLS_PER_TURN=5
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=4096
AI_VISION_MAX_OUTPUT_TOKENS=400
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=0

# Operador y claves internas: generadas automáticamente en .env; vacías en el ejemplo público.
OPERATOR_USERNAME=evaluador
OPERATOR_PASSWORD=
SESSION_SECRET=
CENTRAL_OPERATOR_TOKEN=
CENTRAL_AGENT_TOKEN=
PAYMENT_SIGNING_KEY=

# Bases propias: hosts de la red Docker, no del equipo anfitrión. No cambiar para Compose local.
CENTRAL_API_URL=http://central:8001
CENTRAL_DB_HOST=central-db
CENTRAL_DB_PORT=5432
CENTRAL_DB_NAME=central
CENTRAL_DB_USER=central
CENTRAL_DB_PASSWORD=
MEMORY_DB_HOST=memory-db
MEMORY_DB_PORT=5432
MEMORY_DB_NAME=memory
MEMORY_DB_USER=memory
MEMORY_DB_PASSWORD=

# Límites y datos de demo. El PIN es ficticio y se documentará para el evaluador.
DEMO_PIN=2468
SESSION_TTL_SECONDS=1800
ORDER_TTL_SECONDS=1800
RECEIPT_TTL_SECONDS=86400
PIN_MAX_ATTEMPTS=3
PIN_LOCK_SECONDS=900
CAMPAIGN_FOLLOWUP_HOURS=24
CAMPAIGN_INTERVAL_SECONDS=1
WORKER_CONCURRENCY=2
MEDIA_MAX_BYTES=5242880
AUDIO_MAX_SECONDS=60
IMAGE_MAX_DIMENSION=2048

# Langfuse autoalojado: credenciales locales generadas, no necesitas una cuenta Cloud.
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_USER=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_ROOT_USER=agil
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_INIT_ORG_ID=proyecto-agil
LANGFUSE_INIT_ORG_NAME=Proyecto-Agil
LANGFUSE_INIT_PROJECT_ID=cobranza-demo
LANGFUSE_INIT_PROJECT_NAME=Cobranza-Demo
LANGFUSE_INIT_USER_EMAIL=evaluador@example.test
LANGFUSE_INIT_USER_NAME=Evaluador
LANGFUSE_INIT_USER_PASSWORD=

# Floci local: credenciales FICTICIAS; no son claves de una cuenta AWS real.
FLOCI_ENDPOINT_URL=http://floci:4566
FLOCI_REGION=us-east-1
FLOCI_ACCESS_KEY_ID=test
FLOCI_SECRET_ACCESS_KEY=test
