FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv UV_NO_DEV=1 PATH="/opt/venv/bin:$PATH"
WORKDIR /app
RUN pip install --no-cache-dir uv==0.12.9
COPY pyproject.toml uv.lock ./
COPY apps ./apps
COPY packages ./packages
COPY migrations ./migrations
COPY scripts ./scripts
COPY evals ./evals
RUN uv sync --frozen --all-packages --no-dev && python -c "import tiktoken; tiktoken.get_encoding('o200k_base')" && useradd --uid 10001 --create-home app && chown -R app:app /app
USER app
EXPOSE 8000
CMD ["python", "-m", "scripts.bootstrap", "backend"]
