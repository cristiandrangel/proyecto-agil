FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
ENV PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv PATH="/opt/venv/bin:$PATH" TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
WORKDIR /app
RUN pip install --no-cache-dir uv==0.12.9
COPY pyproject.toml uv.lock start.sh emulate-ec2.sh emulate-ec2.ps1 emulate-ec2.cmd ./
COPY apps ./apps
COPY packages ./packages
COPY migrations ./migrations
COPY scripts ./scripts
COPY evals ./evals
COPY tests ./tests
COPY infra/chatwoot-relay/main.py ./infra/chatwoot-relay/main.py
RUN uv sync --frozen --all-packages --group dev && mkdir -p /opt/tiktoken-cache && python -c "import tiktoken; tiktoken.get_encoding('o200k_base')" && useradd --uid 10001 --create-home tester && chown -R tester:tester /app
USER tester
CMD ["python", "-m", "scripts.run_acceptance"]
