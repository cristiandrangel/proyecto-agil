# Control-plane helper only. The application runs in the EC2 guest's Docker engine.
FROM docker:29-dind@sha256:9e79b879b177fbd72c34376a3dd3d91747da5db49e1f560f76aea59561471977
RUN apk add --no-cache python3 py3-boto3 openssh-client git
ENTRYPOINT ["python3", "-m", "scripts.ec2_emulation"]
CMD ["up"]
